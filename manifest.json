{
  "manifest_version": 3,
  "name": "Discord Ctrl Enter",
  "description": "Prevent accidental Discord sends by making Enter insert a new line and Ctrl+Enter send.",
  "version": "0.5.6",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://discordapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://discordapp.com/*"
      ],
      "js": [
        "src/page-core.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://discordapp.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-core.js",
        "src/page.js"
      ],
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://discordapp.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Discord Ctrl Enter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
